---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<Base title="Writing" description="Build notes: what I set up, what broke, and how I fixed it.">
	<section class="wrap list">
		<span class="eyebrow">Writing</span>
		<h1>Build log</h1>
		<p class="lede">What I set up, what broke, and how I fixed it.</p>
		<ol class="items">
			{
				posts.map((p) => (
					<li>
						<a href={`/blog/${p.id}/`}>
							<time class="mono" datetime={p.data.pubDate.toISOString()}>
								{fmt(p.data.pubDate)}
							</time>
							<span class="t">
								<strong>{p.data.title}</strong>
								<span class="d">{p.data.description}</span>
							</span>
							<span class="arrow" aria-hidden="true">
								→
							</span>
						</a>
					</li>
				))
			}
		</ol>
	</section>
</Base>

<style>
	.list {
		max-width: 860px;
		padding-block: clamp(48px, 8vw, 96px) 40px;
	}
	h1 {
		font-size: clamp(2.4rem, 6vw, 3.6rem);
		margin-top: 0.8rem;
	}
	.items {
		list-style: none;
		padding: 0;
		margin: 2.6rem 0 0;
		border-top: 1px solid var(--line);
	}
	.items a {
		display: grid;
		grid-template-columns: 120px 1fr auto;
		gap: 1.2rem;
		align-items: baseline;
		padding: 1.4rem 0.4rem;
		border-bottom: 1px solid var(--line);
		text-decoration: none;
		transition: background 0.2s;
	}
	.items a:hover {
		background: color-mix(in srgb, var(--surface) 70%, transparent);
	}
	time {
		font-size: 0.8rem;
		color: var(--text-faint);
	}
	.t {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}
	strong {
		font-family: var(--font-display);
		font-size: 1.2rem;
		font-weight: 500;
	}
	.d {
		color: var(--text-muted);
		font-size: 0.93rem;
	}
	.arrow {
		color: var(--accent);
		transition: transform 0.2s;
	}
	.items a:hover .arrow {
		transform: translateX(4px);
	}
	@media (max-width: 600px) {
		.items a {
			grid-template-columns: 1fr;
			gap: 0.4rem;
		}
		.arrow {
			display: none;
		}
	}
</style>
