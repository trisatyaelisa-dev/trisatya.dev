---
// Single sign-on: apps on the left redirect to the realm, a token comes back.
---

<svg class="art" viewBox="0 0 360 210" role="img" aria-label="Illustration of single sign-on with Keycloak">
	<!-- apps -->
	<g class="app g">
		<rect x="14" y="36" width="104" height="40" rx="10"></rect>
		<circle cx="34" cy="56" r="7"></circle>
		<text x="48" y="60">grafana</text>
	</g>
	<g class="app w">
		<rect x="14" y="134" width="104" height="40" rx="10"></rect>
		<circle cx="34" cy="154" r="7"></circle>
		<text x="48" y="158">workbench</text>
	</g>

	<!-- flows -->
	<path id="k-a" class="flow" d="M118 56 C 160 56, 170 98, 214 102"></path>
	<path id="k-b" class="flow" d="M118 154 C 160 154, 170 112, 214 108"></path>

	<g class="token">
		<rect x="-15" y="-8" width="30" height="16" rx="5"></rect>
		<text x="0" y="3.5" text-anchor="middle">JWT</text>
		<animateMotion dur="3.2s" repeatCount="indefinite" keyPoints="1;0" keyTimes="0;1" calcMode="spline" keySplines=".4 0 .2 1">
			<mpath href="#k-a"></mpath>
		</animateMotion>
	</g>
	<g class="token">
		<rect x="-15" y="-8" width="30" height="16" rx="5"></rect>
		<text x="0" y="3.5" text-anchor="middle">JWT</text>
		<animateMotion dur="3.2s" begin="1.6s" repeatCount="indefinite" keyPoints="1;0" keyTimes="0;1" calcMode="spline" keySplines=".4 0 .2 1">
			<mpath href="#k-b"></mpath>
		</animateMotion>
	</g>

	<!-- realm -->
	<g class="realm">
		<rect x="214" y="58" width="132" height="94" rx="16"></rect>
		<g class="shield" transform="translate(252 82)">
			<path d="M14 0 L28 6 V18 C28 28 21 35 14 38 C7 35 0 28 0 18 V6 Z"></path>
			<rect x="9" y="16" width="10" height="9" rx="2" class="lock"></rect>
			<path d="M11 16 v-3 a3 3 0 0 1 6 0 v3" class="shackle"></path>
		</g>
		<text x="288" y="98" class="r1">realm</text>
		<text x="288" y="112" class="r2">trisatya</text>
		<g class="otp">
			<rect x="228" y="126" width="104" height="18" rx="6"></rect>
			<text x="280" y="138.5" text-anchor="middle">OTP · 482 913</text>
		</g>
	</g>
</svg>

<style>
	.art {
		width: 100%;
		height: auto;
		font-family: var(--font-mono), monospace;
	}
	.app rect {
		fill: color-mix(in srgb, var(--surface-2) 90%, transparent);
		stroke: var(--line-strong);
	}
	.app text {
		fill: var(--text-muted);
		font-size: 11px;
	}
	.app.g circle {
		fill: var(--grafana);
	}
	.app.w circle {
		fill: var(--workbench);
	}
	.flow {
		fill: none;
		stroke: color-mix(in srgb, var(--keycloak) 50%, var(--line));
		stroke-width: 1.4;
		stroke-dasharray: 4 5;
		animation: dash 1.6s linear infinite;
	}
	.token rect {
		fill: var(--keycloak);
	}
	.token text {
		fill: #04121c;
		font-size: 8px;
		font-weight: 600;
	}
	.realm > rect {
		fill: color-mix(in srgb, var(--keycloak) 14%, var(--surface));
		stroke: var(--keycloak);
		stroke-width: 1.4;
	}
	.shield path:first-child {
		fill: color-mix(in srgb, var(--keycloak) 30%, transparent);
		stroke: var(--keycloak);
		stroke-width: 1.4;
	}
	.lock {
		fill: var(--keycloak);
	}
	.shackle {
		fill: none;
		stroke: var(--keycloak);
		stroke-width: 1.6;
	}
	.r1 {
		fill: var(--text-faint);
		font-size: 9px;
	}
	.r2 {
		fill: var(--text);
		font-size: 11.5px;
		font-weight: 500;
	}
	.otp rect {
		fill: color-mix(in srgb, var(--bg) 60%, transparent);
		stroke: var(--line);
	}
	.otp text {
		fill: var(--accent);
		font-size: 9.5px;
		letter-spacing: 0.06em;
	}
	@keyframes dash {
		to {
			stroke-dashoffset: -18;
		}
	}
</style>
