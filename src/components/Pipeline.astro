---
const steps = [
	{ k: 'push', title: 'git push', text: 'to main on my personal GitHub' },
	{ k: 'check', title: 'check', text: 'compose config, nginx -t, shellcheck' },
	{ k: 'build', title: 'build', text: 'Docker image to ghcr.io, tagged with the commit SHA' },
	{ k: 'deploy', title: 'deploy', text: 'SSH with a key that can only run deploy.sh' },
	{ k: 'verify', title: 'verify', text: 'health check; on failure, roll back to the previous SHA', branch: true },
	{ k: 'serve', title: 'serve', text: 'Nginx and Let’s Encrypt, behind Cloudflare' },
];

const facts = [
	{ n: '4', t: 'repos that deploy themselves' },
	{ n: '1', t: 'restricted deploy key per repo' },
	{ n: '0', t: 'passwords accepted over SSH' },
	{ n: '03:15', t: 'nightly backups, restore-tested' },
];
---

<div class="pipe" data-reveal>
	<ol class="steps">
		{
			steps.map((s, i) => (
				<li class={`step ${s.branch ? 'branch' : ''}`} style={`--i:${i}`}>
					<span class="idx mono">{String(i + 1).padStart(2, '0')}</span>
					<span class="node" aria-hidden="true" />
					<h3 class="mono">{s.title}</h3>
					<p>{s.text}</p>
					{s.branch && (
						<span class="rollback mono" aria-hidden="true">
							↺ rollback
						</span>
					)}
				</li>
			))
		}
	</ol>

	<dl class="facts">
		{
			facts.map((f) => (
				<div>
					<dt>{f.n}</dt>
					<dd>{f.t}</dd>
				</div>
			))
		}
	</dl>
</div>

<style>
	.pipe {
		margin-top: 3rem;
	}
	.steps {
		--n: 6;
		position: relative;
		display: grid;
		grid-template-columns: repeat(var(--n), 1fr);
		gap: 1rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	/* rail */
	.steps::before,
	.steps::after {
		content: '';
		position: absolute;
		top: 39px;
		left: 8px;
		right: 8px;
		height: 2px;
		border-radius: 2px;
	}
	.steps::before {
		background: var(--line-strong);
	}
	.steps::after {
		background: linear-gradient(90deg, transparent, var(--accent), transparent);
		background-size: 30% 100%;
		background-repeat: no-repeat;
		animation: run 3.6s linear infinite;
	}
	.step {
		position: relative;
		padding-top: 56px;
	}
	.idx {
		position: absolute;
		top: 0;
		left: 0;
		font-size: 0.72rem;
		color: var(--text-faint);
	}
	.node {
		position: absolute;
		top: 32px;
		left: 0;
		width: 16px;
		height: 16px;
		border-radius: 50%;
		background: var(--bg);
		border: 2px solid var(--accent);
		box-shadow: 0 0 0 4px var(--bg);
		z-index: 1;
		animation: light 3.6s linear infinite;
		animation-delay: calc(var(--i) * 0.6s);
	}
	.step h3 {
		font-size: 0.95rem;
		font-weight: 500;
		color: var(--text);
	}
	.step p {
		margin: 0.35rem 0 0;
		font-size: 0.86rem;
		color: var(--text-muted);
		line-height: 1.5;
	}
	.rollback {
		display: inline-block;
		margin-top: 0.6rem;
		font-size: 0.72rem;
		color: var(--warn);
		border: 1px dashed color-mix(in srgb, var(--warn) 60%, transparent);
		border-radius: 999px;
		padding: 0.15em 0.6em;
	}
	@keyframes run {
		from {
			background-position: -40% 0;
		}
		to {
			background-position: 140% 0;
		}
	}
	@keyframes light {
		0%,
		12% {
			background: var(--accent);
		}
		20%,
		100% {
			background: var(--bg);
		}
	}

	.facts {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1px;
		margin: 3.2rem 0 0;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--line);
		overflow: hidden;
	}
	.facts div {
		background: var(--surface);
		padding: 1.3rem 1.4rem;
	}
	.facts dt {
		font-family: var(--font-display);
		font-size: 2rem;
		font-weight: 700;
		letter-spacing: -0.02em;
	}
	.facts dd {
		margin: 0.2rem 0 0;
		color: var(--text-muted);
		font-size: 0.88rem;
	}

	@media (max-width: 900px) {
		.steps {
			grid-template-columns: 1fr;
			gap: 0;
			padding-left: 28px;
		}
		.steps::before,
		.steps::after {
			top: 8px;
			bottom: 8px;
			left: 7px;
			right: auto;
			width: 2px;
			height: auto;
		}
		.steps::after {
			background: linear-gradient(180deg, transparent, var(--accent), transparent);
			background-size: 100% 30%;
			animation-name: run-v;
		}
		.step {
			padding: 0 0 1.6rem;
		}
		.node {
			top: 4px;
			left: -28px;
		}
		.idx {
			position: static;
			display: block;
			margin-bottom: 0.1rem;
		}
		.facts {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@keyframes run-v {
		from {
			background-position: 0 -40%;
		}
		to {
			background-position: 0 140%;
		}
	}
</style>
