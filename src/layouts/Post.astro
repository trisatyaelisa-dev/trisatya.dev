---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';

type Props = CollectionEntry<'blog'>['data'] & { minutes: number };
const { title, description, pubDate, updatedDate, tags, minutes } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title={title} description={description}>
	<article class="wrap post">
		<header class="head">
			<a class="back mono" href="/blog/">← all posts</a>
			<h1>{title}</h1>
			<p class="desc">{description}</p>
			<p class="meta mono">
				<time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
				{updatedDate && <span>· updated {fmt(updatedDate)}</span>}
				<span>· {minutes} min read</span>
			</p>
			{tags.length > 0 && <ul class="tags">{tags.map((t) => <li class="chip">{t}</li>)}</ul>}
		</header>
		<div class="prose">
			<slot />
		</div>
	</article>
</Base>

<style>
	.post {
		max-width: 760px;
		padding-block: clamp(48px, 8vw, 96px) 40px;
	}
	.back {
		font-size: 0.82rem;
		color: var(--text-muted);
		text-decoration: none;
	}
	.back:hover {
		color: var(--text);
	}
	h1 {
		font-size: clamp(2.1rem, 5vw, 3.2rem);
		margin-top: 1.2rem;
	}
	.desc {
		color: var(--text-muted);
		font-size: 1.15rem;
		margin: 1rem 0 0;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 1.2rem 0 0;
		font-size: 0.8rem;
		color: var(--text-faint);
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		padding: 0;
		margin: 1rem 0 0;
	}
	.head {
		padding-bottom: 2rem;
		margin-bottom: 2.4rem;
		border-bottom: 1px solid var(--line);
	}
</style>
